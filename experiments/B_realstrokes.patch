+"""Lift Van Gogh's individual brush strokes off the canvas over the village.
+
+The scan is cut into its separate strokes (regions of one paint, split along
+the lines where the paint changes). Each becomes one record: where it lies on
+the canvas, which way it runs, how long and wide it is, its colour and the
+colour of its lighter streak. Nothing is averaged over a building.
+
+Writes public/starry/village_strokes.bin (header of 8 floats, then 11 floats
+per stroke), village_canvas.jpg (the paint, for colours point by point) and
+village_run.png (which way the paint runs at each point).
+Check picture: reference/debug_village_strokes.jpg (top: canvas, bottom: the
+lifted strokes redrawn as plain bars).
+
+Run: python3 tools/starry/village_strokes.py
+"""
+import math
+from pathlib import Path
+
+import cv2
+import numpy as np
+
+ROOT = Path(__file__).resolve().parents[2]
+img = cv2.imread(str(ROOT / "reference" / "starry_7000.jpg"))
+K = img.shape[1] / 1280.0
+X0, Y0, X1, Y1 = 500.0, 760.0, 1272.0, 1006.0     # in 1280-px units
+S = 0.5                                            # working scale against the 7000 px scan
+U = K * S                                          # working pixels per unit
+CS, RS = 3.0, 2.0                                  # exported canvas / run images, px per unit
+
+crop = img[int(Y0 * K):int(Y1 * K), int(X0 * K):int(X1 * K)]
+work = cv2.resize(crop, None, fx=S, fy=S, interpolation=cv2.INTER_AREA)
+h, w = work.shape[:2]
+
+# --- cut the paint into strokes
+flat = cv2.pyrMeanShiftFiltering(work, 5, 12)               # bristle marks and weave out, edges kept
+lab = cv2.cvtColor(flat, cv2.COLOR_BGR2LAB).astype(np.float32)
+lab = cv2.GaussianBlur(lab, (0, 0), 1.0)
+g = np.zeros((h, w), np.float32)
+for c in range(3):
+    gx, gy = cv2.Sobel(lab[..., c], cv2.CV_32F, 1, 0), cv2.Sobel(lab[..., c], cv2.CV_32F, 0, 1)
+    g = np.maximum(g, np.hypot(gx, gy))
+gs = cv2.GaussianBlur(g, (0, 0), 1.2)
+local = cv2.GaussianBlur(gs, (0, 0), 14)
+core = cv2.erode((gs < 0.68 * local).astype(np.uint8), np.ones((2, 2), np.uint8))                  # the calm middle of each stroke
+# his dark lines are too thin to have a calm middle: find them by their darkness
+# against the paint round them, so each survives as a long thin stroke of its own
+lum0 = cv2.GaussianBlur(flat, (0, 0), 0.8).astype(np.float32) @ np.array([0.114, 0.587, 0.299], np.float32)
+around = cv2.GaussianBlur(lum0, (0, 0), 10)
+dark = ((lum0 < 0.66 * around) & (lum0 < 62)).astype(np.uint8)
+dark = cv2.morphologyEx(dark, cv2.MORPH_OPEN, np.ones((2, 2), np.uint8))
+core[cv2.dilate(dark, np.ones((3, 3), np.uint8)) > 0] = 0
+n, markers = cv2.connectedComponents(core)
+nd, dm = cv2.connectedComponents(dark)
+markers[dm > 0] = dm[dm > 0] + n
+markers = cv2.watershed(flat, markers.astype(np.int32))
+# watershed leaves 1 px lines of -1 between regions: give them to a neighbour
+lines = markers <= 0
+filled = cv2.dilate(markers.astype(np.float32), np.ones((3, 3), np.uint8))
+markers[lines] = filled[lines].astype(np.int32)
+
+soft = cv2.GaussianBlur(work, (0, 0), 1.1).astype(np.float32)
+lum = soft @ np.array([0.114, 0.587, 0.299], np.float32)
+
+# direction the paint runs at each point (structure tensor about one stroke wide)
+grey = cv2.GaussianBlur(cv2.cvtColor(work, cv2.COLOR_BGR2GRAY).astype(np.float32), (0, 0), 1.0)
+sx, sy = cv2.Sobel(grey, cv2.CV_32F, 1, 0), cv2.Sobel(grey, cv2.CV_32F, 0, 1)
+J = [cv2.GaussianBlur(a, (0, 0), 4.5) for a in (sx * sx, sx * sy, sy * sy)]
+along = 0.5 * np.arctan2(2 * J[1], J[0] - J[2]) + math.pi / 2       # image axes, y down
+agree = np.hypot(J[0] - J[2], 2 * J[1]) / (J[0] + J[2] + 1e-6)
+run = -np.arctan2(np.sin(along), np.cos(along))
+run = (run + math.pi / 2) % math.pi - math.pi / 2                    # 0 level, + rising to the right
+
+MAXLEN, MAXWID, MINAREA = 38 * U, 9.0 * U, 14
+out = []
+
+
+def fit(pts):
+    c = pts.mean(0)
+    d = pts - c
+    cov = d.T @ d / len(pts) + np.eye(2) * 0.08
+    ev, evec = np.linalg.eigh(cov)
+    ax = evec[:, 1]
+    return c, ax, 3.6 * math.sqrt(ev[1]), 3.6 * math.sqrt(ev[0])
+
+
+def take(pts, depth=0):
+    """pts: N x 2 (x, y) working pixels of one region."""
+    if len(pts) < MINAREA:
+        return
+    c, ax, L, Wd = fit(pts)
+    solid = len(pts) / max(L * Wd, 1e-3)
+    if depth < 7 and (L > MAXLEN or Wd > MAXWID or (solid < 0.62 and len(pts) > 60)):
+        # one region holding several strokes (a line turning a corner, a broad patch): split it
+        if Wd > MAXWID and L < 2.2 * Wd:
+            # a broad patch: cut it into bands along the way the paint runs there
+            a = float(np.median(run[pts[:, 1].astype(int), pts[:, 0].astype(int)]))
+            nrm = np.array([math.sin(a), math.cos(a)])       # across the stroke (image axes)
+            s = (pts - c) @ nrm
+            side = s > np.median(s)
+        else:
+            s = (pts - c) @ ax
+            side = s > np.median(s)
+        if 4 < side.sum() < len(pts) - 4:
+            take(pts[side], depth + 1)
+            take(pts[~side], depth + 1)
+            return
+    xi, yi = pts[:, 0].astype(int), pts[:, 1].astype(int)
+    col = soft[yi, xi]
+    lm = lum[yi, xi]
+    main = np.median(col, 0)
+    streak = col[lm >= np.percentile(lm, 70)].mean(0)
+    if L < 1.6 * Wd:   # a dab: no clear long axis of its own, so it runs the way the paint runs there
+        a = float(np.median(run[yi, xi]))
+    else:
+        a = -math.atan2(ax[1], ax[0])
+        a = (a + math.pi / 2) % math.pi - math.pi / 2
+    out.append([X0 + c[0] / U, Y0 + c[1] / U, a, max(L, Wd) / U, max(min(L, Wd), 1.6) / U,
+                main[2] / 255, main[1] / 255, main[0] / 255, streak[2] / 255, streak[1] / 255, streak[0] / 255])
+
+
+ys, xs = np.mgrid[0:h, 0:w]
+order = np.argsort(markers.ravel(), kind="stable")
+lab_sorted = markers.ravel()[order]
+bounds = np.flatnonzero(np.diff(lab_sorted)) + 1
+for idx in np.split(order, bounds):
+    if markers.ravel()[idx[0]] <= 0:
+        continue
+    take(np.stack([xs.ravel()[idx], ys.ravel()[idx]], 1).astype(np.float32))
+
+A = np.array(out, np.float32)
+print("strokes", len(A), "median length", np.median(A[:, 3]), "width", np.median(A[:, 4]), "(1280 units)")
+head = np.array([X0, Y0, X1, Y1, CS, RS, len(A), 11], np.float32)
+(ROOT / "public" / "starry" / "village_strokes.bin").write_bytes(head.tobytes() + A.tobytes())
+
+cw, chh = int((X1 - X0) * CS), int((Y1 - Y0) * CS)
+canvas = cv2.resize(cv2.GaussianBlur(crop, (0, 0), 1.6), (cw, chh), interpolation=cv2.INTER_AREA)
+cv2.imwrite(str(ROOT / "public" / "starry" / "village_canvas.jpg"), canvas, [cv2.IMWRITE_JPEG_QUALITY, 90])
+rw, rh = int((X1 - X0) * RS), int((Y1 - Y0) * RS)
+r8 = np.zeros((rh, rw, 3), np.uint8)
+r8[..., 2] = cv2.resize(np.clip((run / math.pi + 0.5) * 255, 0, 255), (rw, rh), interpolation=cv2.INTER_NEAREST).astype(np.uint8)
+r8[..., 1] = cv2.resize(np.clip(agree * 255, 0, 255), (rw, rh), interpolation=cv2.INTER_AREA).astype(np.uint8)
+cv2.imwrite(str(ROOT / "public" / "starry" / "village_run.png"), r8)
+
+# check picture: the strokes redrawn as plain bars, broad ones first
+dbg = np.zeros_like(work)
+dbg[:] = (40, 30, 25)
+for s in sorted(out, key=lambda s: -s[3] * s[4]):
+    cx, cy = (s[0] - X0) * U, (s[1] - Y0) * U
+    box = cv2.boxPoints(((cx, cy), (s[3] * U, s[4] * U), -math.degrees(s[2])))
+    cv2.fillPoly(dbg, [box.astype(np.int32)], (int(s[7] * 255), int(s[6] * 255), int(s[5] * 255)), cv2.LINE_AA)
+cv2.imwrite(str(ROOT / "reference" / "debug_village_strokes.jpg"), np.vstack([work, dbg]), [cv2.IMWRITE_JPEG_QUALITY, 88])
